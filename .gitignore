/docs/product-design/

/canvas/
/outputs/
/generated-images/
/screenshots/
/tmp/
/app/build-identity.json

# Runtime library entries remain local.
/mosa.db*
/legacy-json-backup/

# Electron build output.
/desktop/out/
/out/
