.env
.env.*
!.env.example
npm-debug.log*
*.bak-*

# TypeScript emits runtime modules next to their .ts sources so existing Node
# entry points can resolve their .js specifiers. They are rebuilt by npm
# lifecycle scripts and must never be staged.
/lib/*.js
/lib/*.js.map
/lib/*.d.ts
/dist/

# User libraries and private project material.
/assets/
/production/
/HANDOFF.md
/design-qa.md
/docs/screenshots/

/canvas/
/outputs/

# Runtime library entries remain local.
/mosa.db*
/legacy-json-backup/

# Electron build output.
/desktop/out/
/out/
