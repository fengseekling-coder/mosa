{
  "name": "mosa",
  "version": "0.2.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "config": {
    "forge": "desktop/forge.config.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "mosa": "bin/mosa.mjs"
  },
  "scripts": {
    "prepare": "npm run build",
    "prestart": "npm run build",
    "start": "node server.mjs",
    "premcp": "npm run build",
    "mcp": "node mcp/server.mjs",
    "build": "tsc && node scripts/write-build-identity.mjs",
    "pretest": "npm run build",
    "test": "node --import ./test/clean-test-env.mjs --test",
    "lint": "eslint .",
    "check": "node scripts/check-source.mjs",
    "audit": "npm audit --omit=dev",
    "test:performance": "MOSA_PERF_TEST=1 node --test test/performance.test.mjs",
    "verify:codex": "node scripts/verify-codex-asset.mjs",
    "predesktop:start": "npm run build",
    "desktop:start": "node scripts/desktop-start.mjs",
    "predesktop:package": "npm run build",
    "desktop:package": "electron-forge package --platform darwin --arch arm64",
    "predesktop:make": "npm run build",
    "desktop:make": "electron-forge make --platform darwin --arch arm64",
    "qa:web": "node scripts/qa-launcher.mjs --type web",
    "qa:electron": "node scripts/qa-launcher.mjs --type electron --no-build",
    "qa:packaged": "node scripts/qa-launcher.mjs --type packaged --no-build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "electron": "43.2.0",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "typescript": "5.4.5"
  }
}
