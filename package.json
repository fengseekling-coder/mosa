{
  "name": "mosa",
  "version": "0.2.1",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "config": {
    "forge": "desktop/forge.config.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "mosa": "bin/mosa.mjs"
  },
  "scripts": {
    "prepare": "npm run build",
    "prestart": "npm run build",
    "start": "node server.mjs",
    "premcp": "npm run build",
    "mcp": "node mcp/server.mjs",
    "build": "tsc && node scripts/write-build-identity.mjs",
    "pretest": "npm run build",
    "test": "node --import ./test/clean-test-env.mjs --test \"test/*.test.mjs\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "node scripts/e2e-critical-flows.mjs",
    "test:coverage": "c8 --reporter=html --reporter=text npm test",
    "lint": "eslint .",
    "check": "node scripts/check-source.mjs",
    "check:web-capture-store": "node scripts/check-web-capture-store.mjs",
    "check:web-capture-store:release": "node scripts/check-web-capture-store.mjs --release",
    "pack:web-capture-store": "npm run check:web-capture-store && node scripts/pack-web-capture-store.mjs",
    "audit": "npm audit --omit=dev",
    "test:performance": "node scripts/run-performance.mjs",
    "verify:codex": "node scripts/verify-codex-asset.mjs",
    "check:desktop-node": "node scripts/check-desktop-package-node.mjs",
    "premaintenance:pixel-hashes": "npm run build",
    "maintenance:pixel-hashes": "node scripts/backfill-pixel-hashes.mjs",
    "premaintenance:pixel-hashes:apply": "npm run build",
    "maintenance:pixel-hashes:apply": "node scripts/backfill-pixel-hashes.mjs --apply",
    "predesktop:start": "npm run build",
    "desktop:start": "node scripts/desktop-start.mjs",
    "predesktop:package": "npm run check:desktop-node && npm run build",
    "desktop:package": "electron-forge package --platform darwin --arch arm64",
    "predesktop:package:windows": "npm run check:desktop-node && npm run build",
    "desktop:package:windows": "electron-forge package --platform win32 --arch x64",
    "predesktop:make": "npm run check:desktop-node && npm run build",
    "desktop:make": "electron-forge make --platform darwin --arch arm64",
    "predesktop:make:windows": "npm run check:desktop-node && npm run build",
    "desktop:make:windows": "electron-forge make --platform win32 --arch x64",
    "predesktop:release": "npm run check:desktop-node && npm run build",
    "desktop:release": "MOSA_RELEASE_BUILD=1 electron-forge make --platform darwin --arch arm64",
    "qa:web": "node scripts/qa-launcher.mjs --type web",
    "qa:electron": "node scripts/qa-launcher.mjs --type electron --no-build",
    "qa:packaged": "node scripts/qa-launcher.mjs --type packaged --no-build",
    "qa:packaged:smoke": "node scripts/packaged-smoke.mjs",
    "qa:gallery:performance": "node scripts/qa-gallery-virtualization.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "c8": "^12.0.0",
    "electron": "43.2.0",
    "eslint": "^10.7.0",
    "typescript": "5.4.5"
  }
}
