{
  "manifest_version": 3,
  "name": "MOSA ChatGPT Capture",
  "version": "0.10.0",
  "description": "Archive ChatGPT generation images with message-scoped prompt and asset correlation.",
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.openai.com/*",
    "https://*.oaistatic.com/*",
    "https://*.blob.core.windows.net/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "打开 MOSA Capture 控制台"
  },
  "commands": {
    "toggle-auto-capture": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "切换 MOSA 自动入库"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
